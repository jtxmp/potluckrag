  "dependencies": {
    "hyperswarm": "4.17.2"
  },
  "devDependencies": {
    "hyperdht": "6.34.1",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "packageExtensions": {
      "bogon@1.3.0": {
        "dependencies": {
          "b4a": "^1.6.0"
        }
      }
    }
  },
  "packageManager": "pnpm@10.33.0"
